templ layout(title : String) {
  <!DOCTYPE html>
  <html lang="en">
    <head>
      <meta charset="utf-8">
      <title>{ title }</title>
    </head>
    <body>
      <header class="site-header">
        <h1>{ title }</h1>
      </header>
      <main class="site-main">
        { children... }
      </main>
    </body>
  </html>
}
