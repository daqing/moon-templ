///|
pub fn page(title : String, posts : Array[Post]) -> @rt.Component {
  @rt.component(fn(ctx, w) {
    let ctx = ctx.clear_children()
    layout(title).with_children(@rt.component(fn(ctx, w) {
      w.write_string("<ul class=\"posts\">")
      for post in posts {
        w.write_string("<li class=\"post\">")
        if post.published {
          @ui.card(post.title, post.body).render(ctx, w)
        } else {
          w.write_string("<span class=\"draft\">")
          @rt.write_any(w, post.title)
          w.write_string("</span>")
        }
        w.write_string("</li>")
      }
      w.write_string("</ul>")
    })).render(ctx, w)
  })
}
