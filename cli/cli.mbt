///|
/// Something the command could not do, phrased for whoever typed it.
pub(all) suberror CliError {
  CliError(message~ : String)
}

///|
pub const USAGE : String = "moon-templ generate <file.templ>\n" +
  "       moon-templ generate <dir>/...\n" +
  "       moon-templ generate --watch <dir>/...\n" +
  "       moon-templ fmt <file.templ>\n" +
  "       moon-templ fmt <dir>/..."

///|
/// Where the MoonBit for `hello.templ` goes: `hello_templ.mbt`, beside it. templ
/// names its own output `hello_templ.go` the same way.
pub fn output_path(input : String) -> String {
  let stem = match input.strip_suffix(".templ") {
    Some(view) => view.to_owned()
    None => input
  }
  stem + "_templ.mbt"
}

///|
/// What one generation did.
///
/// A file that already holds this exact generation is reported as `Unchanged`
/// rather than rewritten. Rewriting it would move its modification time and ask
/// every build that watches the file to redo its work for nothing, which is what
/// templ's `-lazy` exists to avoid — the difference is that templ compares the two
/// files' timestamps while this compares their contents, since the content is the
/// thing that actually decides whether the build has anything to do.
pub(all) enum Generated {
  Written(path~ : String)
  Unchanged(path~ : String)
}

///|
fn read(path : String) -> String raise CliError {
  @fs.read_file_to_string(path) catch {
    @fs.IOError(message) =>
      raise CliError(message="cannot read " + path + ": " + message)
  }
}

///|
/// Generate one template file into the file beside it, and report what happened
/// to it.
pub fn generate_file(input : String) -> Generated raise CliError {
  let source = read(input)
  generate_source(input, source)
}

///|
/// Generate the template `source`, which was read from the file `input`. The
/// path is only ever used in reports, so a caller that holds the text of a file
/// it did not read can still name it.
fn generate_source(input : String, source : String) -> Generated raise CliError {
  let generated = try {
    let file = @parser.parse_template_file(source)
    @generator.generate(file)
  } catch {
    @parser.ParseError(offset~, message~) => {
      let (line, column) = @parser.line_column(source, offset)
      raise CliError(
        message=input +
          ":" +
          line.to_string() +
          ":" +
          column.to_string() +
          ": " +
          message,
      )
    }
    @generator.GenerateError(message~) =>
      raise CliError(message=input + ": " + message)
    error => raise CliError(message=input + ": " + error.to_string())
  }
  let target = output_path(input)
  // A generated file may be rewritten freely; anything else in the way is
  // somebody's source, and the header is how we tell the two apart.
  if @fs.path_exists(target) {
    let existing = read(target)
    if !existing.has_prefix(@generator.generated_header()) {
      raise CliError(
        message=target +
          " was not generated by moon-templ, refusing to overwrite it",
      )
    }
    if existing == generated.source {
      return Unchanged(path=target)
    }
  }
  @fs.write_string_to_file(target, generated.source) catch {
    @fs.IOError(message) =>
      raise CliError(message="cannot write " + target + ": " + message)
  }
  Written(path=target)
}

///|
/// The path of `name` inside `dir`, spelled the way the user spelled `dir` so a
/// report reads back the path they typed.
fn join(dir : String, name : String) -> String {
  if dir.has_suffix("/") {
    dir + name
  } else {
    dir + "/" + name
  }
}

///|
/// Whether `path` is a directory. A path that cannot be looked at is not one.
fn is_dir(path : String) -> Bool {
  if !@fs.path_exists(path) {
    return false
  }
  @fs.is_dir(path) catch {
    @fs.IOError(_) => false
  }
}

///|
/// Every `.templ` file under `root`, subdirectories included.
///
/// The walk is in name order — each directory's entries are sorted before they
/// are read, and a subdirectory is walked where its name puts it — so a batch
/// reports its files in the same order on every run and on every machine.
pub fn templ_files_under(root : String) -> Array[String] raise CliError {
  let out : Array[String] = []
  walk(root, out)
  out
}

///|
fn walk(dir : String, out : Array[String]) -> Unit raise CliError {
  let entries = @fs.read_dir(dir) catch {
    @fs.IOError(message) =>
      raise CliError(message="cannot read " + dir + ": " + message)
  }
  let names = entries.to_owned()
  // `Array::sort` would order these by length before content, since that is what
  // MoonBit's `Compare` for strings does; a listing wants the order `ls` gives.
  names.sort_by(fn(a, b) { a[:].lexical_compare(b[:]) })
  for name in names {
    let path = join(dir, name)
    if is_dir(path) {
      walk(path, out)
    } else if name.has_suffix(".templ") {
      out.push(path)
    }
  }
}

///|
/// Whether the argument names a whole tree rather than one file. `./...` is the
/// spelling the Go tools use and templ's own `-path` takes a directory; both are
/// accepted, so `generate examples` and `generate examples/...` walk the same
/// tree.
pub fn is_tree_argument(argument : String) -> Bool {
  argument == "..." || argument.has_suffix("/...")
}

///|
/// The directory a tree argument names. `./...` and `...` both mean the working
/// directory.
pub fn tree_root(argument : String) -> String {
  let path = match argument.strip_suffix("/...") {
    Some(view) => view.to_owned()
    None =>
      match argument.strip_suffix("...") {
        Some(view) => view.to_owned()
        None => argument
      }
  }
  if path.is_empty() {
    "."
  } else {
    path
  }
}

///|
/// How one file of a batch reads in the report.
fn report(result : Generated) -> String {
  match result {
    Written(path~) => "generated " + path
    Unchanged(path~) => path + " is up to date"
  }
}

///|
/// Generate every template under `root`.
///
/// A file that cannot be generated is reported and the batch carries on, so one
/// broken template does not hide the state of the others; the run fails if any of
/// them did. Returns the number of files that failed.
pub fn generate_tree(root : String) -> Int32 raise CliError {
  let files = templ_files_under(root)
  if files.is_empty() {
    raise CliError(message="no .templ files under " + root)
  }
  let mut failures = 0
  for file in files {
    println(report(generate_file(file))) catch {
      CliError(message~) => {
        eprintln("moon-templ: " + message)
        failures = failures + 1
      }
    }
  }
  failures
}

///|
/// What every template under a root held when it was last looked at. The watch
/// loop compares one snapshot with the next to find the files that moved.
pub(all) struct Snapshot {
  files : Map[String, String]
}

///|
/// Read every `.templ` file under `root`, keyed by path.
pub fn snapshot(root : String) -> Snapshot raise CliError {
  let files : Map[String, String] = Map([])
  for path in templ_files_under(root) {
    files[path] = read(path)
  }
  Snapshot::{ files, }
}

///|
/// The paths that are new in `next` or whose text differs from `self`, in name
/// order so a batch reports them the same way every time.
pub fn Snapshot::changed(self : Snapshot, next : Snapshot) -> Array[String] {
  let out : Array[String] = []
  for path, content in next.files {
    let differs = match self.files.get(path) {
      Some(before) => before != content
      None => true
    }
    if differs {
      out.push(path)
    }
  }
  out.sort_by(fn(a, b) { a[:].lexical_compare(b[:]) })
  out
}

///|
/// How often the watch loop looks at the tree.
const WATCH_INTERVAL_MS : Int32 = 250

///|
/// Generate one file during a watch, reporting what happened and the failure
/// rather than raising it: one broken template should not stop the loop.
fn generate_reporting(file : String) -> Unit {
  println(report(generate_file(file))) catch {
    CliError(message~) => eprintln("moon-templ: " + message)
  }
}

///|
/// A snapshot, or `None` after the error was reported. A tree that cannot be
/// read this time may be readable the next one, so the watch loop keeps going.
fn snapshot_reporting(root : String) -> Snapshot? {
  Some(snapshot(root)) catch {
    CliError(message~) => {
      eprintln("moon-templ: " + message)
      None
    }
  }
}

///|
/// Generate every template under `root`, then keep doing so as they change,
/// until the process is interrupted.
///
/// The loop polls instead of asking the operating system for change events: the
/// tree a person edits holds a handful of templates, and reading them costs
/// little next to the generation they ask for. Polling also keeps the command
/// free of platform-specific code, apart from the pause itself.
fn watch_tree(root : String, interval_ms : Int32) -> Unit raise CliError {
  let files = templ_files_under(root)
  if files.is_empty() {
    raise CliError(message="no .templ files under " + root)
  }
  for file in files {
    generate_reporting(file)
  }
  println("watching " + root + " for changes")
  let mut previous = snapshot(root)
  while true {
    pause(interval_ms)
    match snapshot_reporting(root) {
      Some(next) => {
        for file in previous.changed(next) {
          generate_reporting(file)
        }
        previous = next
      }
      None => ()
    }
  }
}

///|
/// What one format run did to a file.
pub(all) enum Formatted {
  Written(path~ : String)
  Unchanged(path~ : String)
}

///|
/// Format the template `source`, which was read from the file `input`; the path
/// is used the way `generate_source` uses it, to point at the place a syntax
/// error was found.
fn format_source_of(input : String, source : String) -> String raise CliError {
  @formatter.format_source(source) catch {
    @parser.ParseError(offset~, message~) => {
      let (line, column) = @parser.line_column(source, offset)
      raise CliError(
        message=input +
          ":" +
          line.to_string() +
          ":" +
          column.to_string() +
          ": " +
          message,
      )
    }
  }
}

///|
/// Rewrite one template file in place, and report what happened to it. A file
/// the formatter would leave as it stands is not rewritten, for the same reason
/// an up-to-date generation is not.
pub fn format_file(input : String) -> Formatted raise CliError {
  let source = read(input)
  let formatted = format_source_of(input, source)
  if formatted == source {
    return Unchanged(path=input)
  }
  @fs.write_string_to_file(input, formatted) catch {
    @fs.IOError(message) =>
      raise CliError(message="cannot write " + input + ": " + message)
  }
  Written(path=input)
}

///|
/// How one file of a batch reads in the report.
fn format_report(result : Formatted) -> String {
  match result {
    Written(path~) => "formatted " + path
    Unchanged(path~) => path + " is already formatted"
  }
}

///|
/// Format every template under `root`. A file that cannot be formatted is
/// reported and the batch carries on, the way `generate_tree` does it; the run
/// fails if any of them did. Returns the number of files that failed.
pub fn format_tree(root : String) -> Int32 raise CliError {
  let files = templ_files_under(root)
  if files.is_empty() {
    raise CliError(message="no .templ files under " + root)
  }
  let mut failures = 0
  for file in files {
    println(format_report(format_file(file))) catch {
      CliError(message~) => {
        eprintln("moon-templ: " + message)
        failures = failures + 1
      }
    }
  }
  failures
}

///|
fn run_format(argv : ArrayView[String]) -> Int32 {
  if argv.length() != 3 {
    eprintln("usage: " + USAGE)
    return 1
  }
  let argument = argv[2]
  try {
    if is_tree_argument(argument) {
      return if format_tree(tree_root(argument)) == 0 { 0 } else { 1 }
    }
    if is_dir(argument) {
      return if format_tree(argument) == 0 { 0 } else { 1 }
    }
    println(format_report(format_file(argument)))
    0
  } catch {
    CliError(message~) => {
      eprintln("moon-templ: " + message)
      1
    }
  }
}

///|
/// Run the command line, argv as the runtime hands it over — the executable
/// first, so the arguments start at index one. Returns the process exit code.
pub fn run(argv : ArrayView[String]) -> Int32 {
  if argv.length() < 2 {
    eprintln("usage: " + USAGE)
    return 1
  }
  match argv[1] {
    "generate" => run_generate(argv)
    "fmt" => run_format(argv)
    other => {
      eprintln("moon-templ: unknown command `" + other + "`")
      eprintln("usage: " + USAGE)
      1
    }
  }
}

///|
fn run_generate(argv : ArrayView[String]) -> Int32 {
  let mut watch = false
  let mut argument : String? = None
  for i = 2; i < argv.length(); i = i + 1 {
    let value = argv[i]
    if value == "--watch" {
      watch = true
    } else if value.has_prefix("-") {
      eprintln("moon-templ: unknown option `" + value + "`")
      eprintln("usage: " + USAGE)
      return 1
    } else if argument is Some(_) {
      eprintln("usage: " + USAGE)
      return 1
    } else {
      argument = Some(value)
    }
  }
  let argument = match argument {
    Some(value) => value
    None => {
      eprintln("usage: " + USAGE)
      return 1
    }
  }
  try {
    if watch {
      let root = if is_tree_argument(argument) {
        tree_root(argument)
      } else {
        argument
      }
      if !is_dir(root) {
        raise CliError(message="watch needs a directory, not " + argument)
      }
      if !watch_supported() {
        raise CliError(
          message="watch mode needs the native target: `moon run --target native`",
        )
      }
      watch_tree(root, WATCH_INTERVAL_MS)
      return 0
    }
    if is_tree_argument(argument) {
      return if generate_tree(tree_root(argument)) == 0 { 0 } else { 1 }
    }
    if is_dir(argument) {
      return if generate_tree(argument) == 0 { 0 } else { 1 }
    }
    println(report(generate_file(argument)))
    0
  } catch {
    CliError(message~) => {
      eprintln("moon-templ: " + message)
      1
    }
  }
}
