///|
/// Every input below parses; a parse failure is a broken test rather than a case
/// under test, so it aborts instead of joining the error type.
fn parse_or_abort(src : String) -> @parser.TemplateFile {
  try @parser.parse_template_file(src) catch {
    @parser.ParseError(message~, ..) =>
      abort("unexpected parse error: " + message)
  } noraise {
    file => file
  }
}

///|
fn generate_source(src : String) -> String raise @generator.GenerateError {
  @generator.generate(parse_or_abort(src)).source
}

///|
fn generate_error_of(src : String) -> String {
  try generate_source(src) catch {
    @generator.GenerateError(message~) => message
  } noraise {
    _ => "<no error>"
  }
}

///|
test "an empty component produces a compilable skeleton" {
  assert_eq(
    generate_source("templ hello() {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn hello() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "parameters are copied into the generated header" {
  assert_eq(
    generate_source("templ greet(name : String, times : Int) {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn greet(name : String, times : Int) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {\n" +
    "    ignore(name)\n" +
    "    ignore(times)\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "a receiver turns the template into a method" {
  assert_eq(
    generate_source("templ (self : Model) greeting() {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn Model::greeting(self : Model) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {\n" +
    "    ignore(self)\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "a method with parameters separates the receiver from them" {
  assert_eq(
    generate_source("templ (m : Model) greeting(name : String) {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn Model::greeting(m : Model, name : String) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {\n" +
    "    ignore(m)\n" +
    "    ignore(name)\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "several templates are emitted in file order" {
  let src = generate_source("templ a() {\n}\n\ntempl b() {\n}\n")
  assert_eq(
    src,
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn a() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n" +
    "\n" +
    "///|\n" +
    "pub fn b() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "a file with no templates is just the header" {
  assert_eq(
    generate_source("// nothing to generate\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n",
  )
}

///|
test "an empty component collects no literals" {
  let file = @parser.parse_template_file("templ hello() {\n}\n")
  assert_eq(@generator.generate(file).literals, [])
}

///|
test "an expression is refused when it holds more than one value" {
  assert_eq(
    generate_error_of("templ hello() {\n  { a, b }\n}\n"),
    "`{ ... }` with more than one value is not supported yet: `{a, b}` (in template `hello`)",
  )
}

///|
test "a refusal names the template the node came from" {
  assert_eq(
    generate_error_of("templ a() {\n}\n\ntempl b() {\n  { a, b }\n}\n"),
    "`{ ... }` with more than one value is not supported yet: `{a, b}` (in template `b`)",
  )
}

///|
/// The HTML a template renders is its literals joined; this is how the tests
/// below read a generated file without depending on its line layout.
fn rendered_html(src : String) -> String raise @generator.GenerateError {
  let buf = StringBuilder()
  for literal in @generator.generate(parse_or_abort(src)).literals {
    buf.write_string(literal)
  }
  buf.to_string()
}

///|
test "an element keeps its tags, and the ones around it merge in" {
  assert_eq(rendered_html("templ t() {\n  <div></div>\n}\n"), "<div></div>")
  assert_eq(
    rendered_html("templ t() {\n  <div>Hello, <span>world</span></div>\n}\n"),
    "<div>Hello, <span>world</span></div>",
  )
}

///|
test "a void element closes itself" {
  assert_eq(rendered_html("templ t() {\n  <br/>\n}\n"), "<br>")
  assert_eq(rendered_html("templ t() {\n  <br>\n}\n"), "<br>")
  assert_eq(
    rendered_html("templ t() {\n  <img src=\"x\">\n}\n"),
    "<img src=\"x\">",
  )
}

///|
test "a self-closing tag on a non-void element still gets an end tag" {
  assert_eq(rendered_html("templ t() {\n  <div/>\n}\n"), "<div></div>")
}

///|
test "attributes are written back as they were read" {
  assert_eq(
    rendered_html(
      "templ t() {\n  <div class=\"a\" id='b' data-x=c>hi</div>\n}\n",
    ),
    "<div class=\"a\" id=\"b\" data-x=\"c\">hi</div>",
  )
  assert_eq(
    rendered_html("templ t() {\n  <input disabled>\n}\n"),
    "<input disabled>",
  )
}

///|
test "an attribute value holding a quote picks the other quote" {
  assert_eq(
    rendered_html("templ t() {\n  <div title='say \"hi\"'>x</div>\n}\n"),
    "<div title='say \"hi\"'>x</div>",
  )
}

///|
/// An expression attribute is the one value the generator cannot put in the
/// literal buffer, because resolving it is what escapes it: the quotes it sits
/// between are literals, and the value goes out through a call of its own.
test "an expression attribute writes its value inside the quotes" {
  assert_eq(
    generate_source("templ t(id : String) {\n  <div id={ id }></div>\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t(id : String) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, w) {\n" +
    "    w.write_string(\"<div id=\\\"\")\n" +
    "    w.write_string(@rt.resolve_attribute_value(id))\n" +
    "    w.write_string(\"\\\"></div>\")\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "an expression attribute is trimmed but copied verbatim" {
  assert_true(
    generate_source("templ t() {\n  <div id={ f(a) + \"x\" }></div>\n}\n").contains(
      "w.write_string(@rt.resolve_attribute_value(f(a) + \"x\"))\n",
    ),
  )
}

///|
/// The call the expression needs is a statement, so it cuts the literal run in
/// two: the quotes it sits between go out on either side of it.
test "an expression attribute cuts the literal run around it" {
  assert_eq(
    generate_literals_of_nodes([
      @parser.Element({
        name: "div",
        attrs: [
          @parser.Constant(name="class", value="a"),
          @parser.Expression(name="id", value=" id "),
          @parser.Constant(name="data-x", value="c"),
        ],
        children: [],
        self_closing: false,
      }),
    ]),
    ["<div class=\"a\" id=\"", "\" data-x=\"c\"></div>"],
  )
}

///|
/// The parameter is read only by the attribute, so the generator must not treat
/// it as unused: an `ignore(id)` here would be a lie about the body.
test "a parameter read only by an attribute is not ignored" {
  let source = generate_source(
    "templ t(id : String, other : String) {\n  <div id={ id }></div>\n}\n",
  )
  assert_true(source.contains("ignore(other)\n"))
  assert_false(source.contains("ignore(id)\n"))
}

///|
test "an empty expression attribute is refused" {
  assert_eq(
    generate_error_of("templ t() {\n  <div id={ }></div>\n}\n"),
    "an expression attribute needs an expression: `id={ }` (in template `t`)",
  )
}

///|
test "an attribute with more than one value is refused" {
  assert_eq(
    generate_error_of("templ t() {\n  <div id={ a, b }></div>\n}\n"),
    "an attribute with more than one value is not supported yet: `id={a, b}` (in template `t`)",
  )
}

///|
test "style and script contents are not parsed as template syntax" {
  assert_eq(
    rendered_html("templ t() {\n  <style>a > b { color: red }</style>\n}\n"),
    "<style>a > b { color: red }</style>",
  )
  assert_eq(
    rendered_html("templ t() {\n  <script>if (a < b) { go() }</script>\n}\n"),
    "<script>if (a < b) { go() }</script>",
  )
}

///|
test "a raw element keeps its attributes and its contents verbatim" {
  assert_eq(
    rendered_html("templ t() {\n  <style media=\"print\">a{}</style>\n}\n"),
    "<style media=\"print\">a{}</style>",
  )
}

///|
test "an element name that merely starts with a raw name is an ordinary element" {
  assert_eq(
    rendered_html("templ t() {\n  <scripts>hi</scripts>\n}\n"),
    "<scripts>hi</scripts>",
  )
}

///|
test "a text body becomes one write_string inside the closure" {
  assert_eq(
    generate_of_nodes([@parser.Text("Hello, world")]),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn hello() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, w) {\n" +
    "    w.write_string(\"Hello, world\")\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "adjacent node types merge into a single call" {
  let source = generate_of_nodes([
    @parser.Text("<div>"),
    @parser.HTMLComment("note"),
    @parser.Text("</div>"),
  ])
  assert_true(
    source.contains("    w.write_string(\"<div><!--note--></div>\")\n"),
  )
}

///|
test "an expression is written between the literals around it" {
  assert_eq(
    generate_of_nodes([
      @parser.Text("Hello, "),
      @parser.StringExpression(" name "),
      @parser.Text("!"),
    ]),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn hello() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, w) {\n" +
    "    w.write_string(\"Hello, \")\n" +
    "    @rt.write_any(w, name)\n" +
    "    w.write_string(\"!\")\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "an expression cuts the literal run it sits in" {
  assert_eq(
    generate_literals_of_nodes([
      @parser.Text("Hello, "),
      @parser.StringExpression(" name "),
      @parser.Text("!"),
    ]),
    ["Hello, ", "!"],
  )
}

///|
test "an expression is trimmed but copied verbatim into the call" {
  assert_true(
    generate_of_nodes([@parser.StringExpression("  name  ")]).contains(
      "    @rt.write_any(w, name)\n",
    ),
  )
  assert_true(
    generate_of_nodes([@parser.StringExpression(" f(a, b) ")]).contains(
      "    @rt.write_any(w, f(a, b))\n",
    ),
  )
}

///|
test "an all-whitespace expression writes nothing" {
  assert_eq(generate_literals_of_nodes([@parser.StringExpression("  ")]), [])
  assert_eq(rendered_html("templ t() {\n  a{ }b\n}\n"), "ab")
}

///|
test "an expression in a parsed template is a node of its own" {
  assert_true(
    generate_source("templ hello() {\n  Hello, { name }!\n}\n").contains(
      "    w.write_string(\"Hello, \")\n" +
      "    @rt.write_any(w, name)\n" +
      "    w.write_string(\"!\")\n",
    ),
  )
}

///|
test "an expression inside an element keeps the tags around it" {
  assert_eq(
    rendered_html("templ t() {\n  <div>{ name }</div>\n}\n"),
    "<div></div>",
  )
  assert_eq(
    generate_literals_of_nodes([
      @parser.Element({
        name: "div",
        attrs: [],
        children: [@parser.StringExpression(" name ")],
        self_closing: false,
      }),
    ]),
    ["<div>", "</div>"],
  )
}

///|
/// Markup nesting is not statement nesting: everything a template body writes
/// lands at the body's own level. Indenting by element depth would fight
/// `moon fmt`, which lines a block's statements up with the block.
test "an element's children do not indent the statements they produce" {
  assert_eq(
    generate_source("templ t() {\n  <div><span>{ name }</span></div>\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, w) {\n" +
    "    w.write_string(\"<div><span>\")\n" +
    "    @rt.write_any(w, name)\n" +
    "    w.write_string(\"</span></div>\")\n" +
    "  })\n" +
    "}\n",
  )
}

///|
/// A parameter the body reads is left alone; `ignore` is only for the ones it
/// does not, since MoonBit warns about those where Go does not.
test "only the parameters the body does not read are ignored" {
  let source = generate_source(
    "templ card(title : String, count : Int) {\n  <p>{ title }</p>\n}\n",
  )
  assert_true(source.contains("    ignore(count)\n"))
  assert_false(source.contains("ignore(title)"))
}

///|
/// `ab` is not a read of `a`, or every parameter would look used as soon as
/// another one shared a prefix.
test "a parameter is not read by a longer name that starts with it" {
  let source = generate_source(
    "templ t(ab : String, a : String) {\n  <p>{ ab }</p>\n}\n",
  )
  assert_true(source.contains("    ignore(a)\n"))
  assert_false(source.contains("ignore(ab)"))
}

///|
/// The parameter's name in markup is text, not a read of the parameter.
test "text that spells a parameter's name does not count as reading it" {
  let source = generate_source("templ t(name : String) {\n  <p>name</p>\n}\n")
  assert_true(source.contains("    ignore(name)\n"))
}

///|
/// A labelled parameter is part of how the caller spells the call, so the
/// generator leaves the name alone even when the body does not read it.
test "a labelled parameter is left unnamed" {
  let source = generate_source("templ t(~name : String) {\n  <p>hi</p>\n}\n")
  assert_false(source.contains("ignore"))
}

///|
/// A body of nothing but empty expressions writes nothing, so there is nothing
/// for the writer parameter to do.
test "a body that writes nothing names the writer as unused" {
  let source = generate_source("templ t() {\n  { }\n}\n")
  assert_true(source.contains("@rt.component(fn(_ctx, _w) {\n"))
}

///|
test "a doc type is emitted as it is written in HTML" {
  assert_true(
    generate_of_nodes([@parser.DocType("html")]).contains(
      "    w.write_string(\"<!doctype html>\")\n",
    ),
  )
}

///|
/// A doctype read from a real template comes back lowercased and with its value
/// untouched, which is how templ writes one too.
test "a parsed doctype keeps its value and takes the lowercase keyword" {
  assert_eq(
    rendered_html("templ t() {\n  <!DOCTYPE HTML>\n}\n"),
    "<!doctype HTML>",
  )
  assert_eq(
    rendered_html("templ t() {\n  <!doctype svg>\n}\n"),
    "<!doctype svg>",
  )
}

///|
/// A comment reaches the output as one literal: the AST drops the delimiters, so
/// writing them back is the generator's job.
test "a parsed comment keeps its delimiters" {
  assert_eq(rendered_html("templ t() {\n  <!--note-->\n}\n"), "<!--note-->")
  assert_eq(rendered_html("templ t() {\n  <!---->\n}\n"), "<!---->")
}

///|
/// A comment between two text runs is a literal like any other, so the run stays
/// a single `write_string` call.
test "a comment does not cut the literal run around it" {
  assert_eq(
    generate_literals_of_nodes([
      @parser.Text("a"),
      @parser.HTMLComment("x"),
      @parser.Text("b"),
    ]),
    ["a<!--x-->b"],
  )
}

///|
test "an HTML comment keeps its delimiters" {
  assert_true(
    generate_of_nodes([@parser.HTMLComment("note")]).contains(
      "    w.write_string(\"<!--note-->\")\n",
    ),
  )
}

///|
test "a body records its literals in file order" {
  assert_eq(
    generate_literals_of_nodes([@parser.Text("a"), @parser.Text("b")]),
    ["ab"],
  )
}

///|
/// Generate from a hand-built body: the parser does not produce every node type
/// yet, but the generator has to handle each of them.
fn generate_of_nodes(
  nodes : Array[@parser.Node],
) -> String raise @generator.GenerateError {
  @generator.generate(hand_built(nodes)).source
}

///|
fn generate_literals_of_nodes(
  nodes : Array[@parser.Node],
) -> Array[String] raise @generator.GenerateError {
  @generator.generate(hand_built(nodes)).literals
}

///|
fn hand_built(nodes : Array[@parser.Node]) -> @parser.TemplateFile {
  @parser.TemplateFile::{
    templates: [
      @parser.Template::{ name: "hello", receiver: "", params: "", nodes, },
    ],
  }
}

///|
/// A receiver without a type annotation is refused.
test "a receiver without a type annotation is refused" {
  assert_eq(
    generate_error_of("templ (self) greeting() {\n}\n"),
    "a template receiver needs a type annotation, e.g. `(self : Model)`, but got `self`",
  )
}

///|
/// templ lets a template be named `Hello` because Go does; MoonBit's `fn` names
/// have to start lowercase, so the refusal has to happen here rather than in a
/// generated file the user never wrote.
test "an uppercase template name is refused" {
  assert_eq(
    generate_error_of("templ Hello() {\n}\n"),
    "a template name must start with a lowercase letter or `_`, because it becomes a MoonBit function name, but this one is `Hello` (in template `Hello`)",
  )
}

///|
test "a method name is held to the same rule as a function name" {
  assert_eq(
    generate_error_of("templ (m : Model) Render() {\n}\n"),
    "a template name must start with a lowercase letter or `_`, because it becomes a MoonBit function name, but this one is `Render` (in template `Render`)",
  )
}

///|
test "a template name that starts with a digit is refused" {
  assert_eq(
    generate_error_of("templ 9lives() {\n}\n"),
    "a template name must start with a lowercase letter or `_`, because it becomes a MoonBit function name, but this one is `9lives` (in template `9lives`)",
  )
}

///|
/// Only the first character is MoonBit's business: capitals inside a name are
/// fine, and so is a leading underscore.
test "an uppercase later in the name is accepted" {
  assert_true(
    generate_source("templ helloWorld() {\n}\n").contains(
      "pub fn helloWorld() -> @rt.Component {",
    ),
  )
  assert_true(
    generate_source("templ _hidden() {\n}\n").contains(
      "pub fn _hidden() -> @rt.Component {",
    ),
  )
}

///|
/// The refusal comes before anything is written, so the name it complains about
/// is the one in the source rather than a half-built file.
test "a refused name says nothing about the templates around it" {
  assert_eq(
    generate_error_of("templ ok() {\n}\n\ntempl Bad() {\n}\n"),
    "a template name must start with a lowercase letter or `_`, because it becomes a MoonBit function name, but this one is `Bad` (in template `Bad`)",
  )
}

///|
test "generated variable names are unique within a run" {
  let out = StringBuilder()
  let gen = @generator.Generator::new(out)
  assert_eq(gen.next_var(), "mt_Var1")
  assert_eq(gen.next_var(), "mt_Var2")
  assert_eq(gen.next_var(), "mt_Var3")
}

///|
test "a fresh run starts its variable names over" {
  let out = StringBuilder()
  assert_eq(@generator.Generator::new(out).next_var(), "mt_Var1")
}

///|
test "a component call renders the component the expression names" {
  assert_eq(
    generate_source("templ t(title : String) {\n  @Card(title)\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t(title : String) -> @rt.Component {\n" +
    "  @rt.component(fn(ctx, w) {\n" +
    "    let ctx = ctx.clear_children()\n" +
    "    Card(title).render(ctx, w)\n" +
    "  })\n" +
    "}\n",
  )
}

///|
/// The `@` that marks the call is not part of the expression, so a reference to
/// another package keeps the one MoonBit spells it with.
test "a package-qualified call keeps the expression's own marker" {
  assert_true(
    generate_source("templ t() {\n  @@ui.Card(\"x\")\n}\n").contains(
      "@ui.Card(\"x\").render(ctx, w)\n",
    ),
  )
}

///|
test "a children block becomes a component the call hands over" {
  assert_eq(
    generate_source("templ t() {\n  @Card() { x }\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t() -> @rt.Component {\n" +
    "  @rt.component(fn(ctx, w) {\n" +
    "    let ctx = ctx.clear_children()\n" +
    "    Card().with_children(@rt.component(fn(_ctx, w) {\n" +
    "      w.write_string(\"x \")\n" +
    "    })).render(ctx, w)\n" +
    "  })\n" +
    "}\n",
  )
}

///|
/// Children that call a component of their own need the context their own
/// closure was handed, not the one outside it.
test "a nested call gives the child closure its own context" {
  assert_true(
    generate_source("templ t() {\n  @A() { @B() }\n}\n").contains(
      "    A().with_children(@rt.component(fn(ctx, w) {\n" +
      "      B().render(ctx, w)\n" +
      "    })).render(ctx, w)\n",
    ),
  )
}

///|
test "a call with an empty block is written as a call" {
  assert_true(
    generate_source("templ t() {\n  @Card() { }\n}\n").contains(
      "    Card().render(ctx, w)\n",
    ),
  )
}

///|
/// The expression is code the caller writes, so what it reads counts as read:
/// an `ignore(title)` here would be a lie about the body.
test "a parameter read only by a call is not ignored" {
  let source = generate_source(
    "templ t(title : String, other : String) {\n  @Card(title)\n}\n",
  )
  assert_true(source.contains("ignore(other)\n"))
  assert_false(source.contains("ignore(title)\n"))
}

///|
/// The call is a statement, so it cuts the literal run in two the way an
/// expression attribute does.
test "a call cuts the literal run around it" {
  assert_eq(
    @generator.generate(parse_or_abort("templ t() {\n  <p>a @c() b</p>\n}\n")).literals,
    ["<p>a ", " b</p>"],
  )
}

///|
test "whitespace around a call survives to the rendered html" {
  assert_eq(rendered_html("templ t() {\n  <p>a @c() b</p>\n}\n"), "<p>a  b</p>")
  assert_eq(
    rendered_html("templ t() {\n  <p>a\n@c()\nb</p>\n}\n"),
    "<p>a b</p>",
  )
}

///|
/// A body that renders children binds them first, then clears the context with
/// the same statement that renders them: what it hands on must not carry the
/// children it was given.
test "a body that renders children binds them and clears the context" {
  assert_eq(
    generate_source("templ layout() {\n  <p>{ children... }</p>\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn layout() -> @rt.Component {\n" +
    "  @rt.component(fn(ctx, w) {\n" +
    "    let children = ctx.children\n" +
    "    let ctx = ctx.clear_children()\n" +
    "    w.write_string(\"<p>\")\n" +
    "    children.render(ctx, w)\n" +
    "    w.write_string(\"</p>\")\n" +
    "  })\n" +
    "}\n",
  )
}

///|
/// Nothing in this body renders children, so binding them would leave a name
/// nothing reads; the context is still cleared, because a component it does
/// render must not see them either.
test "a body that renders no children clears the context without binding" {
  let source = generate_source("templ t() {\n  <p>a</p>\n  @Card()\n}\n")
  assert_true(source.contains("    let ctx = ctx.clear_children()\n"))
  assert_false(source.contains("let children"))
}

///|
/// With neither children nor a component to hand the context to, there is
/// nothing to clear it for.
test "a body that renders neither children nor a component has no preamble" {
  let source = generate_source("templ t() {\n  <p>a</p>\n}\n")
  assert_false(source.contains("ctx.clear_children"))
  assert_false(source.contains("let children"))
}

///|
/// A block is a component of its own, but it closes over the binding the
/// template body made, so a `{ children... }` in there renders the template's
/// children with the block's own context.
test "a children expression inside a call block uses the block's context" {
  assert_eq(
    generate_source("templ t() {\n  @Card() { { children... } }\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t() -> @rt.Component {\n" +
    "  @rt.component(fn(ctx, w) {\n" +
    "    let children = ctx.children\n" +
    "    let ctx = ctx.clear_children()\n" +
    "    Card().with_children(@rt.component(fn(ctx, w) {\n" +
    "      children.render(ctx, w)\n" +
    "    })).render(ctx, w)\n" +
    "  })\n" +
    "}\n",
  )
}

///|
/// The binding comes before the body, so a parameter the body never reads is
/// still ignored, and one it does read is still not.
test "a body with children keeps ignoring the parameters it does not read" {
  let source = generate_source(
    "templ layout(title : String, unused : String) {\n  <h1>{ title }</h1>\n  { children... }\n}\n",
  )
  assert_true(
    source.contains(
      "    ignore(unused)\n" +
      "    let children = ctx.children\n" +
      "    let ctx = ctx.clear_children()\n",
    ),
  )
  assert_false(source.contains("ignore(title)"))
}

///|
test "a children expression cuts the literal run around it" {
  assert_eq(
    @generator.generate(
      parse_or_abort("templ t() {\n  <p>a { children... } b</p>\n}\n"),
    ).literals,
    ["<p>a ", "b</p>"],
  )
}

///|
/// A component that renders children and is called without any renders nothing
/// where they would go: the context carries a component that writes nothing.
test "a call with no children leaves the place empty" {
  assert_eq(
    rendered_html("templ t() {\n  <p>a { children... } b</p>\n}\n"),
    "<p>a b</p>",
  )
}

///|
/// An `if` becomes the same statement in MoonBit, and each condition is template
/// source copied through as it stands: what an `if` may ask is a MoonBit
/// expression, so the compiler that reads the generated file is the one that
/// checks it.
test "an if becomes the same statement in the generated file" {
  assert_eq(
    generate_source(
      "templ t(x : Bool) {\n  if x {\n    <p>a</p>\n  } else if !x {\n    <p>b</p>\n  } else {\n    <p>c</p>\n  }\n}\n",
    ),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t(x : Bool) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, w) {\n" +
    "    if x {\n" +
    "      w.write_string(\"<p>a</p>\")\n" +
    "    } else if !x {\n" +
    "      w.write_string(\"<p>b</p>\")\n" +
    "    } else {\n" +
    "      w.write_string(\"<p>c</p>\")\n" +
    "    }\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "a condition is copied as it stands" {
  assert_true(
    generate_source(
      "templ t(x : Int) {\n  if x>1 && x<10 {\n    <p>a</p>\n  }\n}\n",
    ).contains("    if x>1 && x<10 {\n"),
  )
}

///|
/// A block with no nodes in it has nothing to write, so the statement that comes
/// out is the one without the `else`.
test "an else with no nodes writes no branch" {
  let source = generate_source(
    "templ t(x : Bool) {\n  if x {\n    <p>a</p>\n  } else {\n  }\n}\n",
  )
  assert_true(source.contains("    if x {\n"))
  assert_false(source.contains("else"))
}

///|
test "a parameter read only by a condition is not ignored" {
  let source = generate_source(
    "templ t(flag : Bool) {\n  if flag {\n    <p>a</p>\n  }\n}\n",
  )
  assert_false(source.contains("ignore"))
}

///|
/// The context a statement's body needs is the body's business, so the preamble
/// that clears it stands before the statement, not inside it.
test "a body that renders a component inside an if clears the context first" {
  assert_eq(
    generate_source("templ t(x : Bool) {\n  if x {\n    @Card()\n  }\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn t(x : Bool) -> @rt.Component {\n" +
    "  @rt.component(fn(ctx, w) {\n" +
    "    let ctx = ctx.clear_children()\n" +
    "    if x {\n" +
    "      Card().render(ctx, w)\n" +
    "    }\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "a body that renders children inside an if binds them" {
  let source = generate_source(
    "templ t(x : Bool) {\n  if x {\n    { children... }\n  }\n}\n",
  )
  assert_true(source.contains("    let children = ctx.children\n"))
  assert_true(source.contains("      children.render(ctx, w)\n"))
}

///|
/// What an `if` renders is what its branches write, and the generated file holds
/// every branch's literals: the expected string is the one templ writes for the
/// same template, whose own test asserts the same three ways.
test "an if renders the literals of every branch" {
  assert_eq(
    rendered_html(
      "templ t(x : Bool) {\n  <button>Start</button>\n  if x {\n    <button>If</button>\n  } else if x {\n    <button>ElseIf</button>\n  } else {\n    <button>Else</button>\n  }\n  <button>End</button>\n}\n",
    ),
    "<button>Start</button> <button>If</button> <button>ElseIf</button> <button>Else</button> <button>End</button>",
  )
}
