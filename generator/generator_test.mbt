///|
/// Every input below parses; a parse failure is a broken test rather than a case
/// under test, so it aborts instead of joining the error type.
fn parse_or_abort(src : String) -> @parser.TemplateFile {
  try @parser.parse_template_file(src) catch {
    @parser.ParseError(message~, ..) =>
      abort("unexpected parse error: " + message)
  } noraise {
    file => file
  }
}

///|
fn generate_source(src : String) -> String raise @generator.GenerateError {
  @generator.generate(parse_or_abort(src)).source
}

///|
fn generate_error_of(src : String) -> String {
  try generate_source(src) catch {
    @generator.GenerateError(message~) => message
  } noraise {
    _ => "<no error>"
  }
}

///|
test "an empty component produces a compilable skeleton" {
  assert_eq(
    generate_source("templ hello() {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn hello() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "parameters are copied into the generated header" {
  assert_eq(
    generate_source("templ greet(name : String, times : Int) {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn greet(name : String, times : Int) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "a receiver turns the template into a method" {
  assert_eq(
    generate_source("templ (self : Model) Greeting() {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn Model::Greeting(self : Model) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "a method with parameters separates the receiver from them" {
  assert_eq(
    generate_source("templ (m : Model) Greeting(name : String) {\n}\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn Model::Greeting(m : Model, name : String) -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "several templates are emitted in file order" {
  let src = generate_source("templ a() {\n}\n\ntempl b() {\n}\n")
  assert_eq(
    src,
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn a() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n" +
    "\n" +
    "///|\n" +
    "pub fn b() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, _w) {  })\n" +
    "}\n",
  )
}

///|
test "a file with no templates is just the header" {
  assert_eq(
    generate_source("// nothing to generate\n"),
    "// Code generated by moon-templ. DO NOT EDIT.\n",
  )
}

///|
test "an empty component collects no literals" {
  let file = @parser.parse_template_file("templ hello() {\n}\n")
  assert_eq(@generator.generate(file).literals, [])
}

///|
test "a body node with no handler is refused by name" {
  assert_eq(
    generate_error_of("templ hello() {\n  { name }\n}\n"),
    "cannot generate an expression node yet (in template `hello`)",
  )
}

///|
test "a refusal names the template the node came from" {
  assert_eq(
    generate_error_of("templ a() {\n}\n\ntempl b() {\n  { name }\n}\n"),
    "cannot generate an expression node yet (in template `b`)",
  )
}

///|
/// The HTML a template renders is its literals joined; this is how the tests
/// below read a generated file without depending on its line layout.
fn rendered_html(src : String) -> String raise @generator.GenerateError {
  let buf = StringBuilder()
  for literal in @generator.generate(parse_or_abort(src)).literals {
    buf.write_string(literal)
  }
  buf.to_string()
}

///|
test "an element keeps its tags, and the ones around it merge in" {
  assert_eq(rendered_html("templ t() {\n  <div></div>\n}\n"), "<div></div>")
  assert_eq(
    rendered_html("templ t() {\n  <div>Hello, <span>world</span></div>\n}\n"),
    "<div>Hello, <span>world</span></div>",
  )
}

///|
test "a void element closes itself" {
  assert_eq(rendered_html("templ t() {\n  <br/>\n}\n"), "<br>")
  assert_eq(rendered_html("templ t() {\n  <br>\n}\n"), "<br>")
  assert_eq(
    rendered_html("templ t() {\n  <img src=\"x\">\n}\n"),
    "<img src=\"x\">",
  )
}

///|
test "a self-closing tag on a non-void element still gets an end tag" {
  assert_eq(rendered_html("templ t() {\n  <div/>\n}\n"), "<div></div>")
}

///|
test "attributes are written back as they were read" {
  assert_eq(
    rendered_html(
      "templ t() {\n  <div class=\"a\" id='b' data-x=c>hi</div>\n}\n",
    ),
    "<div class=\"a\" id=\"b\" data-x=\"c\">hi</div>",
  )
  assert_eq(
    rendered_html("templ t() {\n  <input disabled>\n}\n"),
    "<input disabled>",
  )
}

///|
test "an attribute value holding a quote picks the other quote" {
  assert_eq(
    rendered_html("templ t() {\n  <div title='say \"hi\"'>x</div>\n}\n"),
    "<div title='say \"hi\"'>x</div>",
  )
}

///|
test "style and script contents are not parsed as template syntax" {
  assert_eq(
    rendered_html("templ t() {\n  <style>a > b { color: red }</style>\n}\n"),
    "<style>a > b { color: red }</style>",
  )
  assert_eq(
    rendered_html("templ t() {\n  <script>if (a < b) { go() }</script>\n}\n"),
    "<script>if (a < b) { go() }</script>",
  )
}

///|
test "a raw element keeps its attributes and its contents verbatim" {
  assert_eq(
    rendered_html("templ t() {\n  <style media=\"print\">a{}</style>\n}\n"),
    "<style media=\"print\">a{}</style>",
  )
}

///|
test "an element name that merely starts with a raw name is an ordinary element" {
  assert_eq(
    rendered_html("templ t() {\n  <scripts>hi</scripts>\n}\n"),
    "<scripts>hi</scripts>",
  )
}

///|
test "a text body becomes one write_string inside the closure" {
  assert_eq(
    generate_of_nodes([@parser.Text("Hello, world")]),
    "// Code generated by moon-templ. DO NOT EDIT.\n" +
    "\n" +
    "///|\n" +
    "pub fn hello() -> @rt.Component {\n" +
    "  @rt.component(fn(_ctx, w) {\n" +
    "    w.write_string(\"Hello, world\")\n" +
    "  })\n" +
    "}\n",
  )
}

///|
test "adjacent node types merge into a single call" {
  let source = generate_of_nodes([
    @parser.Text("<div>"),
    @parser.HTMLComment("note"),
    @parser.Text("</div>"),
  ])
  assert_true(
    source.contains("    w.write_string(\"<div><!--note--></div>\")\n"),
  )
}

///|
test "a doc type is emitted as it is written in HTML" {
  assert_true(
    generate_of_nodes([@parser.DocType]).contains(
      "    w.write_string(\"<!doctype html>\")\n",
    ),
  )
}

///|
test "an HTML comment keeps its delimiters" {
  assert_true(
    generate_of_nodes([@parser.HTMLComment("note")]).contains(
      "    w.write_string(\"<!--note-->\")\n",
    ),
  )
}

///|
test "a body records its literals in file order" {
  assert_eq(
    generate_literals_of_nodes([@parser.Text("a"), @parser.Text("b")]),
    ["ab"],
  )
}

///|
/// Generate from a hand-built body: the parser does not produce every node type
/// yet, but the generator has to handle each of them.
fn generate_of_nodes(
  nodes : Array[@parser.Node],
) -> String raise @generator.GenerateError {
  @generator.generate(hand_built(nodes)).source
}

///|
fn generate_literals_of_nodes(
  nodes : Array[@parser.Node],
) -> Array[String] raise @generator.GenerateError {
  @generator.generate(hand_built(nodes)).literals
}

///|
fn hand_built(nodes : Array[@parser.Node]) -> @parser.TemplateFile {
  @parser.TemplateFile::{
    templates: [
      @parser.Template::{ name: "hello", receiver: "", params: "", nodes, },
    ],
  }
}

///|
test "a receiver without a type annotation is refused" {
  assert_eq(
    generate_error_of("templ (self) Greeting() {\n}\n"),
    "a template receiver needs a type annotation, e.g. `(self : Model)`, but got `self`",
  )
}

///|
test "generated variable names are unique within a run" {
  let out = StringBuilder()
  let gen = @generator.Generator::new(out)
  assert_eq(gen.next_var(), "mt_Var1")
  assert_eq(gen.next_var(), "mt_Var2")
  assert_eq(gen.next_var(), "mt_Var3")
}

///|
test "a fresh run starts its variable names over" {
  let out = StringBuilder()
  assert_eq(@generator.Generator::new(out).next_var(), "mt_Var1")
}
