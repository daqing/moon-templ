///|
/// What a run of the generator produced: the MoonBit source, plus the literals
/// it wrote in file order. Comparing the literals is how a caller decides
/// whether regenerating a file would change anything.
pub(all) struct GeneratedFile {
  source : String
  literals : Array[String]
} derive(Debug, Eq)

///|
pub extend GeneratedFile with Eq::{equal, not_equal}

///|
pub extend GeneratedFile with @moonbitlang/core/debug.Debug::{to_repr}

///|
/// The state a single run carries: the writer, the counter that hands out
/// variable names unique within the file, and the template being generated, so
/// a node with no handler can say which template it came from.
pub struct Generator {
  priv w : RangeWriter
  priv mut var_id : Int32
  priv mut template : String
}

///|
pub fn Generator::new(out : &Logger) -> Generator {
  { w: RangeWriter::new(out), var_id: 0, template: "", }
}

///|
/// A fresh variable name. The `mt_` prefix keeps generated names out of the way
/// of anything the template itself declares.
pub fn Generator::next_var(self : Generator) -> String {
  self.var_id = self.var_id + 1
  "mt_Var" + self.var_id.to_string()
}

///|
pub fn Generator::literals(self : Generator) -> Array[String] {
  self.w.literals()
}

///|
/// Generate MoonBit source for every template in `file`.
///
/// The result reaches the runtime through the `@rt` alias, so the package that
/// holds the generated file has to declare it in its `moon.pkg`.
pub fn generate(
  file : @parser.TemplateFile,
) -> GeneratedFile raise GenerateError {
  let buf = StringBuilder()
  let gen = Generator::new(buf)
  gen.write_header()
  for template in file.templates {
    gen.write_template(template)
  }
  { source: buf.to_string(), literals: gen.literals(), }
}

///|
/// The first line of every generated file. Callers that have to tell a generated
/// file from a hand-written one compare against this rather than repeat it.
pub fn generated_header() -> String {
  "// Code generated by moon-templ. DO NOT EDIT.\n"
}

///|
fn Generator::write_header(self : Generator) -> Unit {
  self.w.write_indent(0, generated_header())
}

///|
fn Generator::write_template(
  self : Generator,
  template : @parser.Template,
) -> Unit raise GenerateError {
  self.template = template.name
  self.w.write_indent(0, "\n///|\n")
  self.w.write_indent(
    0,
    "pub fn " + declaration(template) + " -> @rt.Component {\n",
  )
  if template.nodes.is_empty() {
    // An empty body touches neither closure parameter, so both are named as
    // unused to keep the generated package warning-free.
    self.w.write_indent(1, "@rt.component(fn(_ctx, _w) {  })\n")
  } else {
    self.w.write_indent(1, "@rt.component(fn(_ctx, w) {\n")
    self.write_nodes(template.nodes, 2)
    self.w.write_indent(1, "})\n")
  }
  self.w.write_indent(0, "}\n")
}

///|
/// Dispatch the nodes of a body to their handlers, in source order, at `level`
/// two-space indents.
fn Generator::write_nodes(
  self : Generator,
  nodes : Array[@parser.Node],
  level : Int32,
) -> Unit raise GenerateError {
  for node in nodes {
    self.write_node(node, level)
  }
}

///|
/// The node dispatch table.
///
/// The match covers every variant of `@parser.Node`, so a node type added to
/// the AST has to be dealt with here instead of falling through and quietly
/// leaving a hole in the output.
fn Generator::write_node(
  self : Generator,
  node : @parser.Node,
  level : Int32,
) -> Unit raise GenerateError {
  match node {
    DocType => self.w.write_literal(level, "<!doctype html>")
    HTMLComment(contents) =>
      self.w.write_literal(level, "<!--" + contents + "-->")
    Element(element) => self.write_element(element, level)
    RawElement(raw) => self.write_raw_element(raw, level)
    Text(text) => self.w.write_literal(level, text)
    StringExpression(expr) => self.write_expression(expr, level)
  }
}

///|
/// An expression is code: it ends the literal run around it, so `Hello, { name }`
/// is two `write_string` calls with the expression's own call between them.
/// Escaping is the runtime's job, since only the value's type says how.
///
/// templ writes nothing at all for an expression that is empty or all
/// whitespace, and so does this.
fn Generator::write_expression(
  self : Generator,
  expr : String,
  level : Int32,
) -> Unit raise GenerateError {
  let value = expr.trim().to_owned()
  if value.is_empty() {
    return
  }
  if @parser.holds_multiple_values(value) {
    raise GenerateError(
      message="`{ ... }` with more than one value is not supported yet: `{" +
        value +
        "}` (" +
        self.location() +
        ")",
    )
  }
  self.w.write_indent(level, "@rt.write_any(w, " + value + ")\n")
}

///|
/// A start tag, the children, and an end tag, all through the literal buffer so
/// a run of them collapses into one `w.write_string` call.
fn Generator::write_element(
  self : Generator,
  element : @parser.Element,
  level : Int32,
) -> Unit raise GenerateError {
  self.write_open_tag(element.name, element.attrs, level)
  // `<br>` and friends have no children and no end tag. A self-closing tag on
  // anything else still gets one: `<div/>` is `<div></div>`.
  if @parser.is_void_element(element.name) && element.children.is_empty() {
    return
  }
  self.write_nodes(element.children, level + 1)
  self.w.write_literal(level, "</" + element.name + ">")
}

///|
fn Generator::write_raw_element(
  self : Generator,
  raw : @parser.RawElement,
  level : Int32,
) -> Unit {
  self.write_open_tag(raw.name, raw.attrs, level)
  self.w.write_literal(level, raw.contents)
  self.w.write_literal(level, "</" + raw.name + ">")
}

///|
fn Generator::write_open_tag(
  self : Generator,
  name : String,
  attrs : Array[@parser.Attribute],
  level : Int32,
) -> Unit {
  self.w.write_literal(level, "<" + name)
  for attr in attrs {
    self.write_attribute(attr, level)
  }
  self.w.write_literal(level, ">")
}

///|
/// Attributes are written as they were read, except for the quoting: the source
/// quotes are not kept in the AST, so the generator picks the one that leaves the
/// value intact.
fn Generator::write_attribute(
  self : Generator,
  attr : @parser.Attribute,
  level : Int32,
) -> Unit {
  match attr {
    Constant(name~, value~) => {
      let quote = if value.contains("\"") { "'" } else { "\"" }
      self.w.write_literal(level, " " + name + "=" + quote + value + quote)
    }
    Bool(name~) => self.w.write_literal(level, " " + name)
  }
}

///|
/// Where the generator currently is, for diagnostics. The AST does not carry
/// source positions yet; T5.1 adds them.
fn Generator::location(self : Generator) -> String {
  "in template `" + self.template + "`"
}

///|
/// The function header, as MoonBit spells it. A receiver turns the template into
/// a method on that type, so `templ (self : Model) Greet()` becomes
/// `Model::Greet(self : Model)`.
fn declaration(template : @parser.Template) -> String raise GenerateError {
  if template.receiver.is_empty() {
    return template.name + "(" + template.params + ")"
  }
  let ty = receiver_type(template.receiver)
  let params = if template.params.is_empty() {
    ""
  } else {
    ", " + template.params
  }
  ty + "::" + template.name + "(" + template.receiver + params + ")"
}

///|
fn receiver_type(receiver : String) -> String raise GenerateError {
  let ty = match after_colon(receiver[:]) {
    Some(rest) => rest.trim().to_owned()
    None => ""
  }
  if ty.is_empty() {
    raise GenerateError(
      message="a template receiver needs a type annotation, e.g. `(self : Model)`, but got `" +
        receiver +
        "`",
    )
  }
  ty
}

///|
fn after_colon(view : StringView) -> StringView? {
  match view {
    [] => None
    [':', .. rest] => Some(rest)
    [_, .. rest] => after_colon(rest)
  }
}
