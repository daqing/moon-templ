///|
/// What a run of the generator produced: the MoonBit source, plus the literals
/// it wrote in file order. Comparing the literals is how a caller decides
/// whether regenerating a file would change anything.
pub(all) struct GeneratedFile {
  source : String
  literals : Array[String]
} derive(Debug, Eq)

///|
pub extend GeneratedFile with Eq::{equal, not_equal}

///|
pub extend GeneratedFile with @moonbitlang/core/debug.Debug::{to_repr}

///|
/// The state a single run carries: the writer, the counter that hands out
/// variable names unique within the file, and the template being generated, so
/// a node with no handler can say which template it came from.
pub struct Generator {
  priv w : RangeWriter
  priv mut var_id : Int32
  priv mut template : String
}

///|
pub fn Generator::new(out : &Logger) -> Generator {
  { w: RangeWriter::new(out), var_id: 0, template: "", }
}

///|
/// A fresh variable name. The `mt_` prefix keeps generated names out of the way
/// of anything the template itself declares.
pub fn Generator::next_var(self : Generator) -> String {
  self.var_id = self.var_id + 1
  "mt_Var" + self.var_id.to_string()
}

///|
pub fn Generator::literals(self : Generator) -> Array[String] {
  self.w.literals()
}

///|
/// Generate MoonBit source for every template in `file`.
///
/// The result reaches the runtime through the `@rt` alias, so the package that
/// holds the generated file has to declare it in its `moon.pkg`.
pub fn generate(
  file : @parser.TemplateFile,
) -> GeneratedFile raise GenerateError {
  let buf = StringBuilder()
  let gen = Generator::new(buf)
  gen.write_header()
  for template in file.templates {
    gen.write_template(template)
  }
  { source: buf.to_string(), literals: gen.literals(), }
}

///|
/// The first line of every generated file. Callers that have to tell a generated
/// file from a hand-written one compare against this rather than repeat it.
pub fn generated_header() -> String {
  "// Code generated by moon-templ. DO NOT EDIT.\n"
}

///|
fn Generator::write_header(self : Generator) -> Unit {
  self.w.write_indent(0, generated_header())
}

///|
fn Generator::write_template(
  self : Generator,
  template : @parser.Template,
) -> Unit raise GenerateError {
  self.template = template.name
  self.check_name(template.name)
  self.w.write_indent(0, "\n///|\n")
  self.w.write_indent(
    0,
    "pub fn " + declaration(template) + " -> @rt.Component {\n",
  )
  let unused = unused_params(template)
  // A template that writes nothing never touches `w`, so the closure names it as
  // unused instead of leaving a warning behind.
  let writer = if emits_output(template.nodes) { "w" } else { "_w" }
  if template.nodes.is_empty() && unused.is_empty() {
    self.w.write_indent(1, "@rt.component(fn(_ctx, _w) {  })\n")
  } else {
    self.w.write_indent(1, "@rt.component(fn(_ctx, " + writer + ") {\n")
    for name in unused {
      self.w.write_indent(2, "ignore(" + name + ")\n")
    }
    self.write_nodes(template.nodes, 2)
    self.w.write_indent(1, "})\n")
  }
  self.w.write_indent(0, "}\n")
}

///|
/// A template name becomes a MoonBit function name — a method name when the
/// template has a receiver — and MoonBit requires those to start with a lowercase
/// letter or an underscore. templ has no such rule, since Go is happy with
/// `Hello()`, so a template brought over unchanged would otherwise come out as a
/// generated file that does not parse, with the compiler complaining about the
/// file the user never wrote.
fn Generator::check_name(
  self : Generator,
  name : String,
) -> Unit raise GenerateError {
  match name.get_char(0) {
    Some(c) => if is_fn_name_start(c) { return }
    None => ()
  }
  raise GenerateError(
    message="a template name must start with a lowercase letter or `_`, because it becomes a MoonBit function name, but this one is `" +
      name +
      "` (" +
      self.location() +
      ")",
  )
}

///|
fn is_fn_name_start(c : Char) -> Bool {
  (c >= 'a' && c <= 'z') || c == '_'
}

///|
/// The parameters a template declares but its body never reads.
///
/// MoonBit warns about an unused parameter where Go does not, and a template's
/// parameters are part of the signature its author asked for, so the body opens
/// by ignoring the ones it does not use. An `ignore` of something that turns out
/// to be used costs nothing, which is why an uncertain answer here is "used":
/// the worst case is a warning, never a broken body.
fn unused_params(template : @parser.Template) -> Array[String] {
  // Declaration order, the receiver first, so the ignores read in the order the
  // generated signature lists them.
  let candidates : Array[String] = []
  match plain_name(template.receiver) {
    Some(name) => candidates.push(name)
    None => ()
  }
  for name in param_names(template.params) {
    candidates.push(name)
  }
  let out : Array[String] = []
  for name in candidates {
    if !mentions_in(template.nodes, name) {
      out.push(name)
    }
  }
  out
}

///|
/// Whether a body writes anything at all. Only an empty expression writes
/// nothing; a tag, a doctype, a comment or any text reaches the output, so this
/// errs towards "it writes".
fn emits_output(nodes : Array[@parser.Node]) -> Bool {
  for node in nodes {
    match node {
      StringExpression(expr) => if !expr.trim().is_empty() { return true }
      Text(text) => if !text.is_empty() { return true }
      Element(_) | RawElement(_) | HTMLComment(_) | DocType(_) => return true
    }
  }
  false
}

///|
/// The parameter names `params` declares, in order. Anything that is not a plain
/// name — a labelled `~name`, an optional `?name` — is left out: the generator
/// may not rewrite what the caller has to spell.
fn param_names(params : String) -> Array[String] {
  let out : Array[String] = []
  for piece in split_top_level(params) {
    match plain_name(piece) {
      Some(name) => out.push(name)
      None => ()
    }
  }
  out
}

///|
fn split_top_level(s : String) -> Array[String] {
  let out : Array[String] = []
  let buf = StringBuilder()
  let mut depth = 0
  for c in s {
    match c {
      '(' | '[' | '{' => {
        depth = depth + 1
        buf.write_char(c)
      }
      ')' | ']' | '}' => {
        if depth > 0 {
          depth = depth - 1
        }
        buf.write_char(c)
      }
      ',' =>
        if depth == 0 {
          out.push(buf.to_string())
          buf.reset()
        } else {
          buf.write_char(c)
        }
      _ => buf.write_char(c)
    }
  }
  out.push(buf.to_string())
  out
}

///|
/// The name a parameter declares, if it declares a plain one: everything before
/// the first `:`, and only when that is an identifier. `None` means the generator
/// will not touch it.
fn plain_name(parameter : String) -> String? {
  let buf = StringBuilder()
  for c in parameter {
    if c == ':' {
      break
    }
    buf.write_char(c)
  }
  let name = buf.to_string().trim().to_owned()
  if name.is_empty() {
    return None
  }
  for c in name {
    if !is_word_char(c) {
      return None
    }
  }
  Some(name)
}

///|
fn is_word_char(c : Char) -> Bool {
  (c >= 'a' && c <= 'z') ||
  (c >= 'A' && c <= 'Z') ||
  (c >= '0' && c <= '9') ||
  c == '_'
}

///|
/// Whether any expression in the body reads `name`. Text nodes are not searched:
/// markup that happens to spell a parameter's name does not use it.
fn mentions_in(nodes : Array[@parser.Node], name : String) -> Bool {
  for node in nodes {
    match node {
      StringExpression(expr) =>
        if mentions(expr[:], name[:], None) {
          return true
        }
      Element(element) =>
        if mentions_in_attrs(element.attrs, name) ||
          mentions_in(element.children, name) {
          return true
        }
      RawElement(raw) => if mentions_in_attrs(raw.attrs, name) { return true }
      Text(_) | HTMLComment(_) | DocType(_) => ()
    }
  }
  false
}

///|
/// Whether any `name={ expr }` attribute reads `name`.
fn mentions_in_attrs(attrs : Array[@parser.Attribute], name : String) -> Bool {
  for attr in attrs {
    match attr {
      Expression(value~, ..) =>
        if mentions(value[:], name[:], None) {
          return true
        }
      Constant(_) | Bool(_) => ()
    }
  }
  false
}

///|
/// Whether `name` occurs in `src` as a whole identifier rather than as part of a
/// longer one, so that a parameter `a` is not counted as read by `abc`.
fn mentions(src : StringView, name : StringView, previous : Char?) -> Bool {
  if src.has_prefix(name) {
    let before = match previous {
      Some(c) => !is_word_char(c)
      None => true
    }
    let after = match src.get_view(start=name.length()) {
      Some(rest) =>
        match rest {
          [c, ..] => !is_word_char(c)
          [] => true
        }
      None => true
    }
    if before && after {
      return true
    }
  }
  match src {
    [] => false
    [c, .. rest] => mentions(rest, name, Some(c))
  }
}

///|
/// Dispatch the nodes of a body to their handlers, in source order, at `level`
/// two-space indents.
fn Generator::write_nodes(
  self : Generator,
  nodes : Array[@parser.Node],
  level : Int32,
) -> Unit raise GenerateError {
  for node in nodes {
    self.write_node(node, level)
  }
}

///|
/// The node dispatch table.
///
/// The match covers every variant of `@parser.Node`, so a node type added to
/// the AST has to be dealt with here instead of falling through and quietly
/// leaving a hole in the output.
fn Generator::write_node(
  self : Generator,
  node : @parser.Node,
  level : Int32,
) -> Unit raise GenerateError {
  match node {
    DocType(value) => self.w.write_literal(level, "<!doctype " + value + ">")
    HTMLComment(contents) =>
      self.w.write_literal(level, "<!--" + contents + "-->")
    Element(element) => self.write_element(element, level)
    RawElement(raw) => self.write_raw_element(raw, level)
    Text(text) => self.w.write_literal(level, text)
    StringExpression(expr) => self.write_expression(expr, level)
  }
}

///|
/// An expression is code: it ends the literal run around it, so `Hello, { name }`
/// is two `write_string` calls with the expression's own call between them.
/// Escaping is the runtime's job, since only the value's type says how.
///
/// templ writes nothing at all for an expression that is empty or all
/// whitespace, and so does this.
fn Generator::write_expression(
  self : Generator,
  expr : String,
  level : Int32,
) -> Unit raise GenerateError {
  let value = expr.trim().to_owned()
  if value.is_empty() {
    return
  }
  if @parser.holds_multiple_values(value) {
    raise GenerateError(
      message="`{ ... }` with more than one value is not supported yet: `{" +
        value +
        "}` (" +
        self.location() +
        ")",
    )
  }
  self.w.write_indent(level, "@rt.write_any(w, " + value + ")\n")
}

///|
/// A start tag, the children, and an end tag, all through the literal buffer so
/// a run of them collapses into one `w.write_string` call.
///
/// Children stay at `level`: markup nests, but it produces one statement where
/// it stands, and only blocks — a template body, and later an `if` or a `for` —
/// move the indentation on. Indenting by element depth would fight `moon fmt`,
/// which lines every statement of a block up at the block's own level.
fn Generator::write_element(
  self : Generator,
  element : @parser.Element,
  level : Int32,
) -> Unit raise GenerateError {
  self.write_open_tag(element.name, element.attrs, level)
  // `<br>` and friends have no children and no end tag. A self-closing tag on
  // anything else still gets one: `<div/>` is `<div></div>`.
  if @parser.is_void_element(element.name) && element.children.is_empty() {
    return
  }
  self.write_nodes(element.children, level)
  self.w.write_literal(level, "</" + element.name + ">")
}

///|
fn Generator::write_raw_element(
  self : Generator,
  raw : @parser.RawElement,
  level : Int32,
) -> Unit raise GenerateError {
  self.write_open_tag(raw.name, raw.attrs, level)
  self.w.write_literal(level, raw.contents)
  self.w.write_literal(level, "</" + raw.name + ">")
}

///|
fn Generator::write_open_tag(
  self : Generator,
  name : String,
  attrs : Array[@parser.Attribute],
  level : Int32,
) -> Unit raise GenerateError {
  self.w.write_literal(level, "<" + name)
  for attr in attrs {
    self.write_attribute(attr, level)
  }
  self.w.write_literal(level, ">")
}

///|
/// Attributes are written as they were read, except for the quoting: the source
/// quotes are not kept in the AST, so the generator picks the one that leaves the
/// value intact.
fn Generator::write_attribute(
  self : Generator,
  attr : @parser.Attribute,
  level : Int32,
) -> Unit raise GenerateError {
  match attr {
    Constant(name~, value~) => {
      let quote = if value.contains("\"") { "'" } else { "\"" }
      self.w.write_literal(level, " " + name + "=" + quote + value + quote)
    }
    Expression(name~, value~) =>
      self.write_expression_attribute(name, value, level)
    Bool(name~) => self.w.write_literal(level, " " + name)
  }
}

///|
/// An expression attribute is written as the escaped value of the expression,
/// inside quotes the generator emits itself. The runtime escapes it, so it goes
/// out through `write_string` rather than through `write_any`.
fn Generator::write_expression_attribute(
  self : Generator,
  name : String,
  value : String,
  level : Int32,
) -> Unit raise GenerateError {
  let expr = value.trim().to_owned()
  if expr.is_empty() {
    raise GenerateError(
      message="an expression attribute needs an expression: `" +
        name +
        "={ }` (" +
        self.location() +
        ")",
    )
  }
  if @parser.holds_multiple_values(expr) {
    raise GenerateError(
      message="an attribute with more than one value is not supported yet: `" +
        name +
        "={" +
        expr +
        "}` (" +
        self.location() +
        ")",
    )
  }
  self.w.write_literal(level, " " + name + "=\"")
  self.w.write_indent(
    level,
    "w.write_string(@rt.resolve_attribute_value(" + expr + "))\n",
  )
  self.w.write_literal(level, "\"")
}

///|
/// Where the generator currently is, for diagnostics. The AST does not carry
/// source positions yet; T5.1 adds them.
fn Generator::location(self : Generator) -> String {
  "in template `" + self.template + "`"
}

///|
/// The function header, as MoonBit spells it. A receiver turns the template into
/// a method on that type, so `templ (self : Model) Greet()` becomes
/// `Model::Greet(self : Model)`.
fn declaration(template : @parser.Template) -> String raise GenerateError {
  if template.receiver.is_empty() {
    return template.name + "(" + template.params + ")"
  }
  let ty = receiver_type(template.receiver)
  let params = if template.params.is_empty() {
    ""
  } else {
    ", " + template.params
  }
  ty + "::" + template.name + "(" + template.receiver + params + ")"
}

///|
fn receiver_type(receiver : String) -> String raise GenerateError {
  let ty = match after_colon(receiver[:]) {
    Some(rest) => rest.trim().to_owned()
    None => ""
  }
  if ty.is_empty() {
    raise GenerateError(
      message="a template receiver needs a type annotation, e.g. `(self : Model)`, but got `" +
        receiver +
        "`",
    )
  }
  ty
}

///|
fn after_colon(view : StringView) -> StringView? {
  match view {
    [] => None
    [':', .. rest] => Some(rest)
    [_, .. rest] => after_colon(rest)
  }
}
